# The static app does not read environment variables automatically.
# Public Firebase web configuration belongs in src/firebase-config.mjs.
# Never add private Firebase admin/service-account keys or AI keys to src/public.
# Optional local server model override:
KINARC_MODEL=qwen2.5:3b
# Optional Java 21 path for Firebase emulators:
KINARC_JAVA_HOME=/path/to/jdk-21
