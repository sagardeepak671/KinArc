rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Merge this KinArc-only block with existing rules. Do not replace another app's rules.
  match /kinarcV2/{uid}/records/{recordId} {
   function owner() { return request.auth != null && request.auth.uid == uid; }
   function valid() {
    let d=request.resource.data;
    return d.keys().hasOnly(['id','key','value','order','revision','baseRevision','deleted','updatedAt'])
      && d.id is string && d.id.size() < 1000
      && d.key is string && d.key.matches('^kinarc[.].*') && d.key != 'kinarc.accountScope'
      && d.value is string && d.value.size() < 100000
      && d.order is number && d.order >= 0 && d.order < 1000000
      && d.revision is string && d.revision.size() > 0 && d.revision.size() < 65
      && (d.baseRevision == null || d.baseRevision is string)
      && d.deleted is bool && d.updatedAt is number && d.updatedAt > 0;
   }
   allow read: if owner();
   allow create, update: if owner() && valid();
   // Deletions are tombstone updates for offline convergence; physical deletion is disallowed.
   allow delete: if false;
  }
 }
}
